+    /* 在途请求在隐藏期间发生：已结束→补读一次；仍在途→标志保留，结束后补读 */
+    if(!agentOpsLoading)loadAgentStatusOps().catch(()=>{});
+    return;
+  }
+  /* 每次返回：先登记一次pending读取需求，再尝试执行；仅真正发请求时消费，退避不提前请求 */
+  agentOpsPendingRead=true;
+  loadAgentStatusOps().catch(()=>{});
+}
